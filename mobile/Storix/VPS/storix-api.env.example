# FILE VÍ DỤ, KHÔNG THAY THẾ GIÁ TRỊ PRODUCTION BẰNG DỮ LIỆU GIẢ.
# Trên VPS hãy tạo /etc/storix-api/storix-api.env với chmod 600.
# ConnectionStrings__StorixDb=<CHUOI_KET_NOI_SQLSERVER_THAT>
# Jwt__Issuer=<ISSUER_GIONG_API_DANG_CHAY>
# Jwt__Audience=<AUDIENCE_GIONG_API_DANG_CHAY>
# Jwt__Key=<BASE64_RANDOM_SECRET_TOI_THIEU_32_BYTES>
# Khi host web trên tên miền KHÁC với API:
# Cors__AllowedOrigins__0=https://ten-mien-web-cua-ban
